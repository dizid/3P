# Environment Variables for Decision Support App
# Copy this file to .env and fill in your values

# ===========================================
# STRIPE (Payment Processing)
# ===========================================
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs from your Stripe Dashboard
# Create a product with two prices: monthly and yearly
VITE_STRIPE_PRICE_MONTHLY=price_...
VITE_STRIPE_PRICE_YEARLY=price_...

# ===========================================
# ANTHROPIC (AI Analysis)
# ===========================================
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ===========================================
# NEON (PostgreSQL Database)
# ===========================================
# Get from https://console.neon.tech - Project Settings > Connection Details
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ===========================================
# APP API KEY (Endpoint protection)
# ===========================================
# Generate with: openssl rand -hex 24
# Must match on both server and client side
APP_API_KEY=
VITE_APP_API_KEY=

# ===========================================
# AUTH (Magic Link)
# ===========================================
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_...

# ===========================================
# DEVELOPMENT
# ===========================================
# These are automatically set by Netlify in production
# URL=http://localhost:5173
# DEPLOY_URL=http://localhost:5173
